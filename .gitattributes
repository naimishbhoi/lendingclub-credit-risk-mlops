# ---------------------------
# Global normalization
# ---------------------------
* text=auto eol=lf

# ---------------------------
# Source code
# ---------------------------
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf

# ---------------------------
# Config / data formats
# ---------------------------
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf

# ---------------------------
# Notebooks
# ---------------------------
*.ipynb text eol=lf filter=nbstripout diff=ipynb

# ---------------------------
# Windows scripts
# ---------------------------
*.bat text eol=crlf
*.cmd text eol=crlf

# ---------------------------
# Binary files (ML artifacts)
# ---------------------------
*.pkl -text -diff
*.joblib -text -diff
*.parquet -text -diff
*.feather -text -diff
*.h5 -text -diff
*.onnx -text -diff
*.pt -text -diff

# Images / docs
*.png -text -diff
*.jpg -text -diff
*.jpeg -text -diff
*.gif -text -diff
*.pdf -text -diff